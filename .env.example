# Application
NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://YOUR-APP-DOMAIN.example

# Aiven PostgreSQL
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_PG_HOST:YOUR_AIVEN_PG_PORT/YOUR_DB?sslmode=require
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20

# Aiven Valkey
# Copy the Aiven Service URI. Aiven currently uses valkeys:// for TLS;
# the app automatically normalizes it to rediss:// for ioredis.
REDIS_URL=valkeys://default:YOUR_PASSWORD@YOUR_AIVEN_VALKEY_HOST:YOUR_AIVEN_VALKEY_PORT

# S3-compatible object storage (Cloudflare R2 is recommended)
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=internal-ai-files
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY
S3_SECRET_KEY=YOUR_R2_SECRET_KEY

# Authentication/security
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
ENCRYPTION_KEY=GENERATE_EXACTLY_64_HEX_CHARACTERS
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Uploads
MAX_FILE_SIZE_MB=350
UPLOAD_PART_SIZE_MB=16

# Optional RAG embeddings
# The provider ID must be created in the Admin panel first.
EMBEDDING_PROVIDER_ID=
EMBEDDING_MODEL=text-embedding-3-small
